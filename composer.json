{
    "name": "phil/ux-bundle",
    "description": "PHIL UX in a Symfony application: the PHIL UX form theme, applied to every form, and the stylesheet of phil/ux-css mapped in AssetMapper",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "design-system",
        "css",
        "form-theme",
        "asset-mapper",
        "symfony-ux",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "composer-runtime-api": "^2.2",
        "phil/ux-css": "^0.5@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/form": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/asset-mapper": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/twig-bridge": "^8.2"
    },
    "suggest": {
        "symfony/asset-mapper": "To serve the stylesheet as phil-ux/phil-ux.css"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\UxBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\UxBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
